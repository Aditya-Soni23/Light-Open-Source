# ---------------------------------------------------------------------------
# LIGHT by DIAMOND — Environment Variables
# ---------------------------------------------------------------------------

# AGORA REAL-TIME VOICE CONFIGURATION (Server-Side Only for Secrets)
# Client connects to Agora using the App ID (public).
# App Certificate must NEVER be leaked to frontend bundles.
VITE_AGORA_APP_ID="8c3ee7f5209846b99763087d2cab533a"
AGORA_APP_ID="8c3ee7f5209846b99763087d2cab533a"
AGORA_APP_CERTIFICATE="" # Paste your Agora App Certificate from Agora Console (Primary Certificate)
# Packaged desktop builds call the deployed HTTPS token service. Leave blank for
# local development, where the Express server handles /api/agora/token.
VITE_API_BASE_URL=""

# FIREBASE CONFIGURATION (Web Client)
VITE_FIREBASE_API_KEY="AIzaSyBzKCZLpEyMW1VE9tw7SEF0TJEtKVxfPJc"
VITE_FIREBASE_AUTH_DOMAIN="light-3dc69.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="light-3dc69"
VITE_FIREBASE_STORAGE_BUCKET="light-3dc69.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="250329336295"
VITE_FIREBASE_APP_ID="1:250329336295:web:36eccbefd8bcbd8b799542"
VITE_FIREBASE_MEASUREMENT_ID="G-LQCQG0QLXM"
# Optional Realtime Database URL (if Realtime Database presence is provisioned):
VITE_FIREBASE_DATABASE_URL="https://light-3dc69-default-rtdb.firebaseio.com"

# FIREBASE ADMIN CONFIGURATION (Server-Side verification)
# Optional service account json path or standard GCP ADC / FIREBASE_CONFIG
FIREBASE_PROJECT_ID="light-3dc69"
# Production token verification must run with a Firebase service account or
# other Google Application Default Credentials. Do not put the JSON in VITE_*
# variables or commit it to source control.
# GOOGLE_APPLICATION_CREDENTIALS="C:\\secure\\light-service-account.json"
# Render uses a secret text field, not a local file. Paste the entire one-line
# service-account JSON into this server-only variable there.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# APPLICATION HOSTING & PORT
PORT="3000"
APP_URL="http://localhost:3000"
# Optional: restrict the hosted token API to a browser origin. The default `*`
# is required for the packaged Tauri app, which has a webview origin.
ACCESS_CONTROL_ALLOW_ORIGIN="*"
