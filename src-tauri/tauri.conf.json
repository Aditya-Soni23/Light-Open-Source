{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LIGHT",
  "version": "0.1.3",
  "identifier": "com.diamond.light",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "wait": false },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LIGHT by DIAMOND",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNDdGRkYyRTAwNjIzNjcKUldSbkl3Ymc4djlId3JsYXRsNHhPUXdLR2Q2SFVHMGpNWnFxdmc3TGJZTElKTlNWMUdWa21mMGYK",
      "endpoints": ["https://github.com/Aditya-Soni23/light-desktop/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
