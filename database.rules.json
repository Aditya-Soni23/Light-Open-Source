{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    },
    "friend_requests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null"
      }
    },
    "friends": {
      ".read": "auth != null",
      "$pairId": {
        ".write": "auth != null"
      }
    },
    "user_friends": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "direct_conversations": {
      ".read": "auth != null",
      "$convId": {
        ".write": "auth != null"
      }
    },
    "direct_messages": {
      "$convId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null"
      }
    },
    "group_messages": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
